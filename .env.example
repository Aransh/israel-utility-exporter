# Copy to .env and fill in what applies. At least one of WATER_ENABLED or
# ELECTRICITY_ENABLED must be "true", or the exporter refuses to start.

# --- General ---
# PORT=9877
# DATA_DIR=/data
# LOG_LEVEL=info
# WEB_CONFIG_FILE=/data/web-config.yml

# --- Water (Read Your Meter Pro) ---
WATER_ENABLED=false
WATER_EMAIL=
WATER_PASSWORD=
# WATER_POLL_INTERVAL_MINUTES=90
# WATER_WEEKLY_WINDOW=sunday
# WATER_PRICE_PER_CUBIC_METER=

# --- Electricity (IEC) ---
ELECTRICITY_ENABLED=false
ELECTRICITY_ID=
# ELECTRICITY_TOKEN_FILE=/data/iec-token.json
# ELECTRICITY_POLL_INTERVAL_MINUTES=60
# ELECTRICITY_TARIFF_MODE=flat
# ELECTRICITY_PRICE_PER_KWH=
# ELECTRICITY_TARIFF_SCHEDULE_FILE=/data/tariff-schedule.json
