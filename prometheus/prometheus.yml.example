# Example Prometheus scrape config for israel-utility-exporter.
# Merge this job (and the rule_files entry) into your existing prometheus.yml.
# docker-compose.yml in this repo already wires up an equivalent config for
# the bundled Prometheus container, so you only need this file if you're
# running your own Prometheus instead.

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: israel-utility-exporter
    # Deliberately well under Prometheus's default 5m query lookback_delta —
    # unrelated to how often the exporter's own poll cadence updates a value
    # (60-90m). A query (instant or range — what Grafana Stat panels use by
    # default) evaluated at time T only finds a series if its newest sample
    # is within lookback_delta of T; older than that, and the series reads
    # as absent, even if the underlying value hasn't changed. So
    # scrape_interval must stay comfortably below lookback_delta regardless
    # of the data's real update cadence, or queries near "now" intermittently
    # (or, if scrape_interval is set well above lookback_delta, almost
    # always) find no sample. Scraping /metrics just reads an in-memory
    # value, so it's nearly free — but if you want a slower scrape_interval
    # for other reasons, raise Prometheus's own --query.lookback-delta
    # startup flag to comfortably exceed it instead (that flag is global, so
    # it also widens the blind spot for detecting a genuinely dead target on
    # every other job on that Prometheus).
    scrape_interval: 1m

    static_configs:
      - targets: ['israel-utility-exporter:9877']
