# Example Prometheus scrape config for israel-utility-exporter.
# Merge this job (and the rule_files entry) into your existing prometheus.yml.
# docker-compose.yml in this repo already wires up an equivalent config for
# the bundled Prometheus container, so you only need this file if you're
# running your own Prometheus instead.

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: israel-utility-exporter
    # Deliberately well under Prometheus's default 5m query lookback_delta,
    # even though the exporter's own poll cadence is much slower (60-90m).
    # Scraping /metrics only reads an in-memory value, so it's nearly free —
    # but scrape_interval >= lookback_delta means any scrape that lands even
    # a few seconds late leaves range queries (what Grafana Stat panels use
    # by default) with no sample inside the lookback window, so a "current
    # value" panel intermittently reads as unconfigured/no-data depending on
    # exactly where the query's step lands. Keep this a few minutes below 5m.
    scrape_interval: 1m

    static_configs:
      - targets: ['israel-utility-exporter:9877']
