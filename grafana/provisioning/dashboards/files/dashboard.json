{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "row", "name": "Row", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" }
  ],
  "title": "Israel Utility Exporter",
  "uid": "israel-utility-exporter",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": { "from": "now-30d", "to": "now" },
  "refresh": "5m",
  "tags": ["israel-utility-exporter", "water", "electricity"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Water", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },

    {
      "id": 2,
      "type": "stat",
      "title": "Water Meter Reading",
      "description": "Cumulative water meter reading.",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "last_over_time(israel_utility_water_meter_reading_cubic_meters[3d])", "legendFormat": "Meter {{meter_id}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "m3",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Water Collector Health",
      "description": "Whether the last poll of the water portal succeeded.",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "timeFrom": "10m",
      "targets": [{ "expr": "israel_utility_water_scrape_success", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Water Rate vs Normal",
      "description": "This month's estimated blended water rate as a percentage of the normal rate. Above 100% means usage has spilled into the pricier tier.",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "100 * last_over_time(israel_utility_water_effective_rate_ils_per_cubic_meter[3d]) / last_over_time(israel_utility_water_tariff_normal_rate_ils_per_cubic_meter[3d])",
          "legendFormat": "Meter {{meter_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "flat mode / not configured",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 100 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Water Cost Estimate",
      "description": "Estimated cost so far this month, the portal's forecast for month-end, and last month's estimated final cost. Includes VAT.",
      "gridPos": { "x": 0, "y": 7, "w": 10, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "timeFrom": "7d",
      "targets": [
        { "expr": "last_over_time(israel_utility_water_cost_estimate_ils[3d])", "legendFormat": "Month to date, ${__to:date:MMM} (meter {{meter_id}})", "refId": "A" },
        { "expr": "last_over_time(israel_utility_water_cost_estimate_forecast_ils[3d])", "legendFormat": "Forecast, month end (meter {{meter_id}})", "refId": "B" },
        { "expr": "last_over_time(israel_utility_water_cost_estimate_previous_month_ils[3d])", "legendFormat": "Last month, {{month}} (meter {{meter_id}})", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyILS",
          "decimals": 2,
          "noValue": "not configured",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^Last month" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "semi-dark-gray" } }]
          }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Water Cost Trend (Month to Date)",
      "description": "How this month's estimated cost has accumulated so far, against the portal's forecast and last month's final cost. Includes VAT.",
      "gridPos": { "x": 10, "y": 7, "w": 14, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "last_over_time(israel_utility_water_cost_estimate_ils[3d])", "legendFormat": "Month to date (meter {{meter_id}})", "refId": "A" },
        { "expr": "last_over_time(israel_utility_water_cost_estimate_forecast_ils[3d])", "legendFormat": "Forecast, month end (meter {{meter_id}})", "refId": "B" },
        { "expr": "last_over_time(israel_utility_water_cost_estimate_previous_month_ils[3d])", "legendFormat": "Last month, {{month}} (meter {{meter_id}})", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyILS", "custom": { "spanNulls": true, "lineInterpolation": "stepAfter" } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^Last month" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "semi-dark-gray" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^Forecast" },
            "properties": [{ "id": "custom.fillOpacity", "value": 0 }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Daily Water Consumption",
      "description": "Water used on the most recently published day.",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_water_consumption_daily_liters", "legendFormat": "Meter {{meter_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "litre", "custom": { "spanNulls": true, "lineInterpolation": "stepAfter" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Weekly / Monthly Water Consumption vs Forecast",
      "description": "Water used this week and this month so far, against the portal's forecast and the monthly allowance.",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "israel_utility_water_consumption_weekly_liters", "legendFormat": "Weekly (meter {{meter_id}})", "refId": "A" },
        { "expr": "israel_utility_water_consumption_monthly_liters", "legendFormat": "Monthly (meter {{meter_id}})", "refId": "B" },
        { "expr": "israel_utility_water_consumption_forecast_liters", "legendFormat": "Forecast (meter {{meter_id}})", "refId": "C" },
        {
          "expr": "israel_utility_water_tariff_threshold_cubic_meters * 1000",
          "legendFormat": "Monthly Limit (meter {{meter_id}})",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "litre", "custom": { "spanNulls": true, "lineInterpolation": "stepAfter" } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^Monthly Limit" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cumulative Water Meter Reading",
      "description": "The meter reading over time.",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_water_meter_reading_cubic_meters", "legendFormat": "Meter {{meter_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "m3", "custom": { "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 20, "type": "row", "title": "Electricity", "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },

    {
      "id": 21,
      "type": "stat",
      "title": "Electricity Meter Reading",
      "description": "Cumulative electricity meter reading.",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "last_over_time(israel_utility_electricity_meter_reading_kwh[3d])", "legendFormat": "Contract {{contract_id}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Electricity Collector Health",
      "description": "Whether the last poll of the IEC API succeeded.",
      "gridPos": { "x": 18, "y": 30, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "timeFrom": "10m",
      "targets": [{ "expr": "israel_utility_electricity_scrape_success", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Effective Rate (Today)",
      "description": "Today's estimated blended electricity rate. Includes VAT.",
      "gridPos": { "x": 12, "y": 30, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "last_over_time(israel_utility_electricity_effective_rate_ils_per_kwh[3d])", "legendFormat": "Contract {{contract_id}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyILS",
          "decimals": 3,
          "noValue": "flat mode / not configured",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Electricity Cost Estimate (Month to Date)",
      "description": "Estimated cost so far this month, and last month's estimated final cost. Includes VAT.",
      "gridPos": { "x": 0, "y": 36, "w": 10, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "timeFrom": "7d",
      "targets": [
        { "expr": "last_over_time(israel_utility_electricity_cost_estimate_monthly_ils[3d])", "legendFormat": "Month to date, ${__to:date:MMM} (contract {{contract_id}})", "refId": "A" },
        { "expr": "last_over_time(israel_utility_electricity_cost_estimate_previous_month_ils[3d])", "legendFormat": "Last month, {{month}} (contract {{contract_id}})", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyILS",
          "decimals": 2,
          "noValue": "not configured",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^Last month" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "semi-dark-gray" } }]
          }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Electricity Cost Trend (Month to Date)",
      "description": "How this month's estimated cost has accumulated so far, against last month's final cost. Includes VAT.",
      "gridPos": { "x": 10, "y": 36, "w": 14, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "last_over_time(israel_utility_electricity_cost_estimate_monthly_ils[3d])", "legendFormat": "Month to date (contract {{contract_id}})", "refId": "A" },
        { "expr": "last_over_time(israel_utility_electricity_cost_estimate_previous_month_ils[3d])", "legendFormat": "Last month, {{month}} (contract {{contract_id}})", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyILS", "custom": { "spanNulls": true, "lineInterpolation": "stepAfter" } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^Last month" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "semi-dark-gray" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Daily Electricity Consumption",
      "description": "Electricity used on the most recently published day.",
      "gridPos": { "x": 0, "y": 42, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_electricity_consumption_daily_kwh", "legendFormat": "Contract {{contract_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "kwatth", "custom": { "spanNulls": true, "lineInterpolation": "stepAfter" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Monthly Electricity Consumption",
      "description": "Electricity used this calendar month so far.",
      "gridPos": { "x": 12, "y": 42, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_electricity_consumption_monthly_kwh", "legendFormat": "Contract {{contract_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "kwatth", "custom": { "spanNulls": true, "lineInterpolation": "stepAfter" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Cumulative Electricity Meter Reading",
      "description": "The meter reading over time.",
      "gridPos": { "x": 0, "y": 50, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_electricity_meter_reading_kwh", "legendFormat": "Contract {{contract_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "kwatth", "custom": { "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
