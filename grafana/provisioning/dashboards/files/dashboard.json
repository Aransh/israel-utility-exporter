{
  "title": "Israel Utility Exporter",
  "uid": "israel-utility-exporter",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": { "from": "now-30d", "to": "now" },
  "refresh": "5m",
  "tags": ["israel-utility-exporter", "water", "electricity"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Water", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },

    {
      "id": 2,
      "type": "stat",
      "title": "Water Meter Reading",
      "description": "Cumulative meter reading. If this stops moving entirely, check WaterScrapeStale in Alerting.",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_water_meter_reading_cubic_meters", "legendFormat": "Meter {{meter_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "m3", "decimals": 3 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Water Collector Health",
      "description": "1 = last poll of the Read Your Meter Pro portal succeeded.",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_water_scrape_success", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Water Cost Estimate (Month to Date)",
      "description": "Only populated when WATER_PRICE_PER_CUBIC_METER is set (flat mode) or WATER_TARIFF_MODE=tiered is fully configured.",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_water_cost_estimate_ils", "legendFormat": "Meter {{meter_id}}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "currencyILS", "decimals": 2, "noValue": "not configured" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Water Effective Rate (Tiered Mode)",
      "description": "This month-to-date consumption's blended ILS/m3 rate, given WATER_TARIFF_HOUSEHOLD_SIZE and the allowance. Only populated in WATER_TARIFF_MODE=tiered.",
      "gridPos": { "x": 0, "y": 7, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "israel_utility_water_effective_rate_ils_per_cubic_meter", "legendFormat": "Meter {{meter_id}}", "refId": "A", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyILS", "decimals": 3, "noValue": "flat mode / not configured" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Water Tariff Threshold (Tiered Mode, Month to Date)",
      "description": "WATER_TARIFF_HOUSEHOLD_SIZE x WATER_TARIFF_ALLOWANCE_PER_PERSON_CUBIC_METERS. Consumption above this is priced at WATER_TARIFF_EXCESS_PRICE_PER_CUBIC_METER. Only populated in WATER_TARIFF_MODE=tiered.",
      "gridPos": { "x": 8, "y": 7, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_water_tariff_threshold_cubic_meters", "legendFormat": "Meter {{meter_id}}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "m3", "decimals": 2, "noValue": "flat mode / not configured" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Water Forecast Cost Estimate (Month End)",
      "description": "Estimated cost of the portal's own month-end forecast, priced the same way as the month-to-date estimate (flat or tiered).",
      "gridPos": { "x": 16, "y": 7, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_water_cost_estimate_forecast_ils", "legendFormat": "Meter {{meter_id}}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "currencyILS", "decimals": 2, "noValue": "not configured" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Daily Water Consumption",
      "description": "Not always today's figure — the portal publishes a day's reading with a lag; check *_covers_timestamp_seconds if a value looks stale.",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_water_consumption_daily_liters", "legendFormat": "Meter {{meter_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "litre", "custom": { "spanNulls": true, "lineInterpolation": "stepAfter" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Weekly / Monthly Water Consumption vs Forecast",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "israel_utility_water_consumption_weekly_liters", "legendFormat": "Weekly (meter {{meter_id}})", "refId": "A" },
        { "expr": "israel_utility_water_consumption_monthly_liters", "legendFormat": "Monthly (meter {{meter_id}})", "refId": "B" },
        { "expr": "israel_utility_water_consumption_forecast_liters", "legendFormat": "Forecast (meter {{meter_id}})", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "litre", "custom": { "spanNulls": true, "lineInterpolation": "stepAfter" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cumulative Water Meter Reading",
      "description": "The long-term trend the Home app can't show you. A flattening slope is lower usage; a step change worth investigating is usually a leak.",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_water_meter_reading_cubic_meters", "legendFormat": "Meter {{meter_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "m3" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 20, "type": "row", "title": "Electricity", "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },

    {
      "id": 21,
      "type": "stat",
      "title": "Electricity Meter Reading",
      "description": "Cumulative meter reading. IEC only updates this every 1-2 days regardless of poll frequency.",
      "gridPos": { "x": 0, "y": 30, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_electricity_meter_reading_kwh", "legendFormat": "Contract {{contract_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "kwatth", "decimals": 1 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Electricity Collector Health",
      "description": "1 = last poll of the IEC API succeeded. If this is stuck at 0, check the exporter logs — likely the token needs a fresh login.",
      "gridPos": { "x": 6, "y": 30, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_electricity_scrape_success", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Electricity Cost Estimate (Newest Day)",
      "description": "Only populated when ELECTRICITY_PRICE_PER_KWH or a tariff schedule is configured. In schedule mode this is a duration-weighted estimate, not a bill reconstruction — see README.",
      "gridPos": { "x": 12, "y": 30, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_electricity_cost_estimate_ils", "legendFormat": "Contract {{contract_id}}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "currencyILS", "decimals": 2, "noValue": "not configured" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Effective Rate (Today, Schedule Mode)",
      "description": "Only populated in ELECTRICITY_TARIFF_MODE=schedule. The duration-weighted blended ILS/kWh rate for today, given the configured time-of-use windows.",
      "gridPos": { "x": 18, "y": 30, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_electricity_effective_rate_ils_per_kwh", "legendFormat": "Contract {{contract_id}}", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "currencyILS", "decimals": 3, "noValue": "flat mode / not configured" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Daily Electricity Consumption",
      "description": "One point roughly every 1-2 days, matching IEC's own publication cadence.",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_electricity_consumption_daily_kwh", "legendFormat": "Contract {{contract_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "kwatth", "custom": { "spanNulls": true, "lineInterpolation": "stepAfter" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Monthly Electricity Consumption",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_electricity_consumption_monthly_kwh", "legendFormat": "Contract {{contract_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "kwatth", "custom": { "spanNulls": true, "lineInterpolation": "stepAfter" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Cumulative Electricity Meter Reading",
      "description": "The long-term trend the Home app can't show you.",
      "gridPos": { "x": 0, "y": 44, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "israel_utility_electricity_meter_reading_kwh", "legendFormat": "Contract {{contract_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "kwatth" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
